{
  "manifest_version": 3,
  "name": "Sada · YouTube playback",
  "description": "Sends YouTube playback timing to the local Sada desktop app.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["watch.js"],
      "run_at": "document_idle"
    }
  ]
}
